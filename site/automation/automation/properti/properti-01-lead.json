      "id": "n7",
      "name": "Baca Lead Aktif",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst now = Date.now();\nreturn rows.filter(r => {\n  if (r.status !== 'baru') return false;\n  const t = new Date(r.waktu).getTime();\n  return (now - t) / 86400000 >= 2;\n}).map(r => ({ json: r }));\n"
      },
      "id": "n8",
      "name": "Filter Diam > 2 Hari",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        520
      ],
      "notes": "Lead yang diam lebih dari 2 hari."
    },
