            },
            {
              "name": "message",
              "value": "Halo {{$json.nama}}, masih cari {{$json.tipe}} di {{$json.lokasi}}?\\n\\nKami baru update beberapa listing yang mungkin cocok. Mau dikabari? Balas aja ya."
            }
          ]
        },
        "options": {}
