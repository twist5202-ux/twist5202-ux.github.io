{
  "name": "EVENT 03 — Seating Plan + Doorprize Draw Otomatis",
  "nodes": [
    {
      "parameters": {
        "path": "ev-checkin",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Check-in Tamu",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "ev-checkin"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nconst nama = String(b.nama || '').toLowerCase().trim();\nconst rows = $('Baca Daftar Tamu').all().map(r => r.json);\n\nconst ketemu = rows.find(r =>\n  String(r.nama || '').toLowerCase().trim() === nama);\n\nif (!ketemu) {\n  return [{ json: { ditemukan: false, nama: b.nama } }];\n}\nreturn [{ json: { ditemukan: true, ...ketemu } }];\n"
      },
      "id": "n2",
      "name": "Cek Tamu Terdaftar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Cocokkan nama tamu dengan daftar RSVP."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "GANTI_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "RSVP",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Baca Daftar Tamu",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{ $json.ditemukan ? 1 : 0 }}",
              "rightValue": "1",
              "operator": {
                "type": "number",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Terdaftar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "GANTI_TOKEN_FONNTE"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "Selamat datang, {{$json.nama}}! 🎊\\n\\nCheck-in berhasil.\\nMeja : {{$json.meja || 'akan diinformasikan'}}\\nNomor doorprize: {{$json.nomor_doorprize || '-'}}\\n\\nSelamat menikmati acara 💛"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Selamat Datang",
