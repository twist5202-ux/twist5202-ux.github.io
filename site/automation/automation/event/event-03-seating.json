      "id": "n8",
      "name": "Draw Doorprize Tiap Acara Selesai",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        180,
        620
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "GANTI_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Kehadiran",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n9",
      "name": "Baca Yang Hadir",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        420,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst pool = rows.filter(r => r.nama);\nif (pool.length < 3) return [{ json: { skip: true } }];\n\nconst pemenang = [];\nconst salinan = [...pool];\nfor (let i = 0; i < 3 && salinan.length > 0; i++) {\n  const idx = Math.floor(Math.random() * salinan.length);\n  pemenang.push(salinan.splice(idx, 1)[0]);\n}\n\nlet out = 'PEMENANG DOORPRIZE 🎁\\n===================\\n\\n';\npemenang.forEach((p, i) => {\n  out += (i + 1) + '. ' + p.nama + ' — ' + (p.meja || 'meja -') + '\\n';\n});\nreturn [{ json: { skip: false, hasil: out } }];\n"
      },
      "id": "n10",
      "name": "Undi 3 Pemenang",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        620
      ],
      "notes": "Undi 3 pemenang acak dari yang hadir."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
