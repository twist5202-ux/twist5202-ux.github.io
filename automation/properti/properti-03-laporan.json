{
  "name": "PROPERTI 03 — Laporan Performa Listing Mingguan",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Tiap Senin 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "GANTI_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Listing",
          "mode": "name"
        },
        "options": {}
      },
      "id": "n2",
      "name": "Baca Data Listing",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        -60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(r => r.json);\nconst total = rows.length;\nconst terjual = rows.filter(r => (r.status || '') === 'terjual').length;\nconst view = rows.reduce((s, r) => s + (Number(r.view) || 0), 0);\nconst lead = rows.reduce((s, r) => s + (Number(r.lead) || 0), 0);\nconst konversi = view > 0 ? (lead / view * 100).toFixed(1) : '0';\n\nlet out = 'PERFORMA LISTING MINGGUAN\\n========================\\n\\n';\nout += 'Total listing : ' + total + '\\n';\nout += 'Terjual       : ' + terjual + '\\n';\nout += 'Total view    : ' + view.toLocaleString('id') + '\\n';\nout += 'Total lead    : ' + lead + '\\n';\nout += 'Konversi      : ' + konversi + '%\\n\\n';\n\n// listing terbaik\nconst sorted = [...rows].sort((a, b) => (Number(b.lead)||0) - (Number(a.lead)||0));\nif (sorted.length > 0) {\n  out += 'PALING BANYAK LEAD:\\n';\n  out += '  ' + (sorted[0].judul || sorted[0].properti || '-') +\n         ' (' + (sorted[0].lead || 0) + ' lead)\\n\\n';\n}\nout += 'Listing tanpa lead perlu foto/harga di-review.';\nreturn [{ json: { laporan: out } }];\n"
      },
      "id": "n3",
      "name": "Hitung Performa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "notes": "Hitung view, lead, konversi per listing."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "GANTI_TOKEN_FONNTE"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "GANTI_NOMOR_WA_ADMIN"
            },
            {
              "name": "message",
              "value": "={{$json.laporan}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Kirim Laporan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    }
  ],
  "connections": {
    "Tiap Senin 08:00": {
      "main": [
        [
          {
            "node": "Baca Data Listing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Baca Data Listing": {
      "main": [
        [
          {
            "node": "Hitung Performa",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hitung Performa": {
      "main": [
        [
          {
            "node": "Kirim Laporan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}