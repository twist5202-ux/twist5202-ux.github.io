{
  "name": "CRYPTO 09 — Funding Rate Scanner (Cari Peluang Arbitrage)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "id": "n1",
      "name": "Cek Tiap 4 Jam",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://fapi.binance.com/fapi/v1/premiumIndex?symbol=BTCUSDT",
        "options": {}
      },
      "id": "n2",
      "name": "Ambil Funding Rate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $input.first().json;\nconst rate = parseFloat(d.lastFundingRate) * 100;  // persen\nconst annual = rate * 3 * 365;                       // 3x sehari\nconst arah = rate > 0 ? 'Long bayar Short' : 'Short bayar Long';\n\nlet out = 'FUNDING RATE BTC\\n================\\n';\nout += 'Rate sekarang : ' + rate.toFixed(4) + '%\\n';\nout += 'Arah          : ' + arah + '\\n';\nout += 'Annualized    : ' + annual.toFixed(2) + '%\\n\\n';\n\nif (Math.abs(annual) > 20) {\n  out += '🔥 PELUANG BESAR — annualized di atas 20%';\n} else if (Math.abs(annual) > 10) {\n  out += '👀 Lumayan — pantau terus';\n} else {\n  out += '😴 Normal — gak ada peluang khusus';\n}\nreturn [{ json: { laporan: out, annual } }];\n"
      },
      "id": "n3",
      "name": "Analisa Funding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "n4-c",
              "leftValue": "={{Math.abs($json.annual)}}",
              "rightValue": "10",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n4",
      "name": "Annualized > 10%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "GANTI_TOKEN_FONNTE"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "GANTI_NOMOR_WA_ADMIN"
            },
            {
              "name": "message",
              "value": "={{$json.laporan}}"
            }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "Alert Peluang Funding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Cek Tiap 4 Jam": {
      "main": [
        [
          {
            "node": "Ambil Funding Rate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil Funding Rate": {
      "main": [
        [
          {
            "node": "Analisa Funding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analisa Funding": {
      "main": [
        [
          {
            "node": "Annualized > 10%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Annualized > 10%?": {
      "main": [
        [
          {
            "node": "Alert Peluang Funding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}