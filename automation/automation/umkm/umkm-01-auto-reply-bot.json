{
  "name": "UMKM 01 — Auto-Reply WhatsApp (Keyword Bot)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-masuk",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "trigger",
      "name": "Pesan WhatsApp Masuk",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        320
      ],
      "webhookId": "wa-masuk-umkm",
      "notes": "Di dashboard Fonnte set webhook ke URL ini supaya pesan WhatsApp masuk diteruskan ke n8n.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "nomor_wa",
              "type": "string",
              "value": "={{ $json.body.sender || $json.sender || $json.query.sender }}"
            },
            {
              "id": "a2",
              "name": "pesan_masuk",
              "type": "string",
              "value": "={{ $json.body.message || $json.message || $json.query.message }}"
            },
            {
              "id": "a3",
              "name": "chat_id",
              "type": "string",
              "value": "={{ $json.body.sender || $json.sender || $json.query.sender }}"
            }
          ]
        },
        "options": {}
      },
      "id": "norm",
      "name": "Baca Pesan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        320
      ],
      "notes": "Fonnte mengirim field \"sender\" (nomor WA) dan \"message\" (isi pesan).",
      "notesInFlow": false
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s1",
                    "leftValue": "={{ $json.pesan }}",
                    "rightValue": "halo|hai|hi|pagi|siang|sore|malam|assalamualaikum",
                    "operator": {
                      "type": "string",
                      "operation": "matchesRegex"
                    }
                  }
                ],
                "combinator": "or"
              },
              "outputKey": "sapaan"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s2",
                    "leftValue": "={{ $json.pesan }}",
                    "rightValue": "harga|price|berapa|biaya|tarif|list harga",
                    "operator": {
                      "type": "string",
                      "operation": "matchesRegex"
                    }
                  }
                ],
                "combinator": "or"
              },
              "outputKey": "harga"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s3",
                    "leftValue": "={{ $json.pesan }}",
                    "rightValue": "jam|buka|tutup|operasional|kapan",
                    "operator": {
                      "type": "string",
                      "operation": "matchesRegex"
                    }
                  }
                ],
                "combinator": "or"
              },
              "outputKey": "jam"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s4",
                    "leftValue": "={{ $json.pesan }}",
                    "rightValue": "alamat|lokasi|dimana|maps|kantor|toko",
                    "operator": {
                      "type": "string",
                      "operation": "matchesRegex"
                    }
                  }
                ],
                "combinator": "or"
              },
              "outputKey": "alamat"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s5",
                    "leftValue": "={{ $json.pesan }}",
                    "rightValue": "order|pesan|beli|booking|reservasi|kirim",
                    "operator": {
                      "type": "string",
                      "operation": "matchesRegex"
                    }
                  }
                ],
                "combinator": "or"
              },
              "outputKey": "order"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "s6",
                    "leftValue": "={{ $json.pesan }}",
                    "rightValue": "admin|manusia|cs|tanya|komplain|masalah",
                    "operator": {
                      "type": "string",
                      "operation": "matchesRegex"
                    }
                  }
                ],
                "combinator": "or"
              },
              "outputKey": "admin"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "lainnya"
        }
      },
      "id": "switch",
      "name": "Deteksi Maksud",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        680,
        320
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "balasan",
              "value": "=Halo {{ $json.nama }}! 👋\n\nSelamat datang di *[NAMA TOKO ANDA]*\n\nSaya asisten virtual yang siap bantu 24 jam.\n\nKetik:\n• *harga* — lihat daftar harga\n• *jam* — jam operasional\n• *alamat* — lokasi toko\n• *order* — cara pesan\n• *admin* — bicara dengan tim kami",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-sapaan",
      "name": "Balas Sapaan",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b2",
              "name": "balasan",
              "value": "=💰 *DAFTAR HARGA*\n\n📦 Produk A — Rp 50.000\n📦 Produk B — Rp 75.000\n📦 Produk C — Rp 100.000\n\n_(Edit daftar ini sesuai produk Anda)_\n\nKetik *order* untuk mulai pesan, atau *admin* untuk tanya-tanya dulu.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-harga",
      "name": "Balas Harga",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b3",
              "name": "balasan",
              "value": "=🕐 *JAM OPERASIONAL*\n\nSenin – Jumat: 08.00 – 17.00\nSabtu: 08.00 – 15.00\nMinggu & Tanggal Merah: Libur\n\n_(Edit sesuai jam buka toko Anda)_",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-jam",
      "name": "Balas Jam Buka",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        320
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b4",
              "name": "balasan",
              "value": "=📍 *LOKASI KAMI*\n\n[NAMA TOKO]\nJl. Contoh Alamat No. 123\nKecamatan, Kota Anda\n\nGoogle Maps: https://maps.google.com/?q=ALAMAT_ANDA\n\n_(Edit alamat ini)_",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-alamat",
      "name": "Balas Alamat",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        420
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b5",
              "name": "balasan",
              "value": "=🛒 *CARA ORDER*\n\n1. Ketik produk yang mau dipesan\n2. Kirim nama lengkap\n3. Kirim alamat pengiriman\n4. Tim kami konfirmasi + kirim link pembayaran\n\nEstimasi pengiriman: 1-3 hari kerja.\n\nAtau ketik *admin* kalau mau dibantu langsung.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-order",
      "name": "Balas Order",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        520
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b6",
              "name": "balasan",
              "value": "=Baik {{ $json.nama }}, saya hubungkan ke tim kami ya. 🙏\n\nTim kami akan balas dalam jam kerja (08.00-17.00 WIB).\n\nKalau urgent, hubungi langsung:\n📞 08xx-xxxx-xxxx\n📧 email@tokoanda.com\n\n_(Edit kontak ini)_",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-admin",
      "name": "Balas Hubungi Admin",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        620
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b7",
              "name": "balasan",
              "value": "=Maaf {{ $json.nama }}, saya belum paham maksud Anda. 🤔\n\nSaya bisa bantu dengan:\n• *harga* — daftar harga\n• *jam* — jam buka\n• *alamat* — lokasi toko\n• *order* — cara pesan\n• *admin* — hubungi tim kami\n\nCoba ketik salah satu kata di atas ya.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "r-lain",
      "name": "Balas Tidak Paham",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        720
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "GANTI_TOKEN_FONNTE"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.nomor_wa }}"
            },
            {
              "name": "message",
              "value": "={{ $json.balasan }}"
            }
          ]
        },
        "options": {}
      },
      "id": "kirim",
      "name": "Kirim Balasan (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        400
      ],
      "notes": "Token Fonnte dari dashboard fonnte.com -> Device -> Token. Ganti GANTI_TOKEN_FONNTE.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "content": "## UMKM 01 — Auto-Reply Bot\n\n**Cocok untuk:** toko online, jasa, kuliner, laundry, bengkel, salon.\n\n**Yang client harus edit:**\n- Nama toko\n- Daftar harga\n- Jam operasional\n- Alamat + Google Maps\n- Kontak admin\n\nSemua ada di node *Balas ...* — tinggal ganti teks.\n\n**Upgrade ke AI:**\nTambah node *AI Agent* + *Groq/Gemini* (gratis) supaya bisa jawab pertanyaan bebas, bukan cuma keyword.",
        "height": 380,
        "width": 600,
        "color": 3
      },
      "id": "note",
      "name": "Panduan",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        80
      ]
    }
  ],
