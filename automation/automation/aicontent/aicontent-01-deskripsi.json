{
  "name": "AICONTENT 01 — Deskripsi Produk Otomatis (Marketplace Ready)",
  "nodes": [
    {
      "parameters": {
        "path": "ai-desc",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Request Deskripsi",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "ai-desc"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  nama: b.nama_produk || b.nama || 'Produk',\n  kategori: b.kategori || 'umum',\n  bahan: b.bahan || '-',\n  warna: b.warna || '-',\n  ukuran: b.ukuran || '-',\n  harga: b.harga || '-',\n  target: b.target || 'pembeli online Indonesia',\n  tone: b.tone || 'santai, meyakinkan, tidak berlebihan'\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Produk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan input produk."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "GANTI_BASE_URL_AI/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer GANTI_API_KEY_AI"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'GANTI_MODEL_AI', messages: [{ role: 'system', content: Kamu copywriter e-commerce Indonesia. Buat deskripsi produk yang siap tempel di Shopee/Tokopedia/Tokped. Bahasa Indonesia santai. Struktur: (1) hook 1 kalimat, (2) 3-4 bullet keunggulan, (3) spesifikasi singkat, (4) call to action. Maksimal 150 kata. Jangan mengarang klaim yang gak bisa dibuktikan. }], temperature: 0.7, max_tokens: 500 }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "n3",
      "name": "Generate Deskripsi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $input.first().json;\nconst teks = r.choices?.[0]?.message?.content || r.message?.content || '';\nreturn [{ json: { deskripsi: teks.trim() } }];\n"
      },
      "id": "n4",
      "name": "Ambil Hasil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "notes": "Ekstrak teks dari respons AI."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "GANTI_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Deskripsi",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n5",
      "name": "Simpan Deskripsi",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "GANTI_TOKEN_FONNTE"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "GANTI_NOMOR_WA_ADMIN"
            },
            {
              "name": "message",
              "value": "DESKRIPSI PRODUK JADI ✍️\\n======================\\n\\n{{$('Ambil Hasil').first().json.deskripsi}}\\n\\nTersimpan di Sheets."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
      "name": "Kirim ke Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Request Deskripsi": {
      "main": [
        [
          {
            "node": "Normalize Produk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Produk": {
      "main": [
        [
          {
            "node": "Generate Deskripsi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Deskripsi": {
      "main": [
        [
          {
            "node": "Ambil Hasil",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ambil Hasil": {
      "main": [
        [
          {
            "node": "Simpan Deskripsi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Simpan Deskripsi": {
      "main": [
        [
          {
            "node": "Kirim ke Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
