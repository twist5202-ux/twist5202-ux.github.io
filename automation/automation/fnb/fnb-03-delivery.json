{
  "name": "FNB 03 — Delivery Order Tracker (Status ke Pelanggan)",
  "nodes": [
    {
      "parameters": {
        "path": "fnb-delivery",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "n1",
      "name": "Order Delivery Masuk",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "webhookId": "fnb-delivery"
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  order_id: b.order_id || 'ORD-' + Date.now(),\n  pelanggan: b.nama || 'Pelanggan',\n  wa: String(b.wa || b.phone || '').replace(/[^0-9]/g, ''),\n  items: b.items || '-',\n  total: Number(b.total || 0),\n  alamat: b.alamat || '-',\n  status: 'diterima',\n  waktu: new Date().toLocaleString('id-ID')\n}}];\n"
      },
      "id": "n2",
      "name": "Normalize Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "notes": "Samakan format order delivery."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "GANTI_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Delivery",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "n3",
      "name": "Catat Order",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "GANTI_TOKEN_FONNTE"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "target",
              "value": "={{ $json.target }}"
            },
            {
              "name": "message",
              "value": "ORDER DITERIMA 🧾\\n================\\nOrder  : {{$json.order_id}}\\nItems  : {{$json.items}}\\nTotal  : Rp {{$json.total}}\\nAlamat : {{$json.alamat}}\\n\\nPesanan sedang diproses. Kami kabari lagi kalau sudah dikirim."
            }
          ]
        },
        "options": {}
      },
      "id": "n4",
      "name": "Konfirmasi Order Diterima",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "GANTI_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
