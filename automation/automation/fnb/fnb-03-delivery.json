            },
            {
              "name": "message",
              "value": "PESANAN SEDANG DIPROSES 👨‍🍳\\nOrder : {{$('Normalize Order').first().json.order_id}}\\nEstimasi : 20-30 menit\\n\\nSebentar ya, lagi dimasak fresh."
            }
          ]
        },
        "options": {}
      },
      "id": "n6",
