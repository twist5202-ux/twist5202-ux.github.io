            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hadir?": {
      "main": [
        [
          {
            "node": "Terima Kasih (Hadir)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Konfirmasi Tidak Hadir",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Terima Kasih (Hadir)": {
      "main": [
        [
          {
            "node": "Notif EO",
