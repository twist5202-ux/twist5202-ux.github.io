    {
      "parameters": {
        "jsCode": "\nconst { sender, text } = $(\"Normalize Pesan\").first().json;\nconst rows = $(\"Baca Tab State\").all().map(r => r.json);\n\nlet target = \"\";\nconst m = text.match(/ke\\s*(62\\d{6,})\\s*[:\\-]?\\s*([\\s\\S]*)/i);\nif (m) {\n  target = m[1];\n  text = m[2].trim();\n}\n\nif (!target) {\n  const humanRows = rows.filter(r => (r.mode || \"ai\") === \"human\");\n  if (humanRows.length > 0) {\n    humanRows.sort((a, b) =>\n      new Date(b.escalated_at || 0) - new Date(a.escalated_at || 0));\n    target = String(humanRows[0].phone || \"\").replace(/[^0-9]/g, \"\");\n  }\n}\n\nconst tutup = /^(tutup|selesai|close|done|sudah)/i.test(text.trim());\n\nreturn [{\n  json: {\n    admin: sender,\n    target,\n    pesan_admin: text.trim(),\n    tutup,\n    ada_target: !!target\n  }\n}];\n"
      },
