      "parameters": {
        "jsCode": "\nconst b = $input.first().json.body || $input.first().json;\n\nconst sender = String(b.sender || b.from || b.phone || \"\").replace(/[^0-9]/g, \"\");\nlet text = String(b.message || b.text || b.body || \"\").trim();\nconst pushname = b.pushname || b.sender_name || \"\";\n\nconst ADMIN = \"GANTI_NOMOR_WA_ADMIN\".replace(/[^0-9]/g, \"\");\nconst from_admin = sender === ADMIN;\n\nreturn [{\n  json: {\n    sender,\n    text,\n    pushname,\n    from_admin,\n    waktu: new Date().toLocaleString(\"id-ID\")\n  }\n}];\n"
      },
