    {
      "parameters": {
        "jsCode": "\nconst resp = $input.first().json;\nlet balasan = resp.choices?.[0]?.message?.content || resp.message?.content || \"\";\n\nconst escalate_marker = /\\[ESCALATE\\]/i.test(balasan);\nbalasan = balasan.replace(/\\[ESCALATE\\]/gi, \"\").trim();\n\nconst { text } = $(\"Normalize Pesan\").first().json;\nconst t = text.toLowerCase();\n\nconst kata = [\n  \"manusia\", \"orang\", \"admin asli\", \"bicara sama orang\", \"cs asli\",\n  \"komplain\", \"keluhan\", \"marah\", \"kesal\", \"tidak puas\", \"kecewa\",\n  \"refund\", \"pengembalian\", \"uang kembali\", \"ganti barang\", \"rusak\",\n  \"lapor\", \"report\", \"pengaduan\", \"penipuan\", \"scam\",\n  \"manager\", \"atasan\", \"pemilik\", \"bos\"\n];\nconst kena_kata = kata.filter(k => t.includes(k));\n\nconst ragu = /(tidak tahu|tidak bisa|cek dulu|tidak memiliki akses|di luar)/i.test(balasan);\n\nconst escalate = escalate_marker || kena_kata.length > 0 || ragu;\n\nlet alasan = \"manual\";\nif (escalate_marker) alasan = \"AI minta eskalasi\";\nelse if (kena_kata.length > 0) alasan = \"keyword: \" + kena_kata.join(\", \");\nelse if (ragu) alasan = \"AI tidak yakin\";\n\nreturn [{\n  json: {\n    balasan,\n    escalate,\n    alasan,\n    kena_kata\n  }\n}];\n"
      },
