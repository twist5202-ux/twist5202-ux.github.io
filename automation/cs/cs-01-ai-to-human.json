    {
      "parameters": {
        "jsCode": "\nconst { sender, text, pushname } = $(\"Normalize Pesan\").first().json;\nconst st = $(\"Cek Mode Percakapan\").first().json;\n\nconst riwayat = (st.history || []).map(h =>\n  (h.dari === \"customer\" ? \"Customer\" : \"CS\") + \": \" + h.pesan\n).join(\"\\n\") || \"(belum ada riwayat)\";\n\nconst sistem =\n  \"Kamu adalah CS virtual \" + BIZ + \". Jawab dalam bahasa Indonesia santai.\\n\" +\n  \"Jam operasional: \" + JAM + \".\\n\" +\n  \"Aturan:\\n\" +\n  \"1. Jawab singkat, maksimal 3 kalimat, jelas, tidak bertele-tele.\\n\" +\n  \"2. Kalau tidak tahu jawabannya, katakan 'saya cek dulu ke tim' JANGAN mengarang.\\n\" +\n  \"3. Kalau customer minta bicara dengan manusia, komplain keras, minta refund,\\n\" +\n  \"   atau masalah di luar kemampuanmu, tulis [ESCALATE] di baris pertama.\\n\" +\n  \"4. Jangan janji hal yang tidak pasti (pengiriman, refund, diskon).\\n\" +\n  \"5. Sapa customer pakai nama kalau ada.\";\n\nconst user =\n  \"Riwayat chat:\\n\" + riwayat + \"\\n\\n\" +\n  \"Nama customer: \" + (pushname || \"tidak diketahui\") + \"\\n\" +\n  \"Pesan customer: \" + text + \"\\n\\n\" +\n  \"Jawab sekarang.\";\n\nreturn [{\n  json: {\n    model: \"GANTI_MODEL_AI\",\n    messages: [\n      { role: \"system\", content: sistem },\n      { role: \"user\", content: user }\n    ],\n    temperature: 0.3,\n    max_tokens: 400\n  }\n}];\n"
      },
      "id": "n19",
      "name": "Susun Prompt AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
