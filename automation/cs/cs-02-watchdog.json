      ],
      "notes": "Update baris di tab 'State', cocokkan kolom 'phone'."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.menit_tunggu }}",
